# Supabase Postgres — direct connection string used by `pg` (raw SQL, no ORM, Data API disabled)
DATABASE_URL=

# Supabase project URL and key, used only for Storage (presigned upload URLs)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket name for event photos
SUPABASE_STORAGE_BUCKET=

# Secret used to sign the host PIN session cookie (any long random string)
SESSION_SECRET=
