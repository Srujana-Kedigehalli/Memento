# Supabase Postgres connection string used by `pg` (raw SQL, no ORM, Data API disabled).
# Prefer the pooled connection string for serverless.
DATABASE_URL=

# Supabase project URL and service key, used only for Storage (signed upload/read URLs).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Name of the PRIVATE Supabase Storage bucket for event photos (25 MB per-file limit).
SUPABASE_STORAGE_BUCKET=

# Guest verification. VERIFICATION_CHANNEL selects the provider; "email" is the current channel.
VERIFICATION_CHANNEL=email
# Long random string used to HMAC the 6-digit verification codes stored in otp_codes.
VERIFICATION_PEPPER=
# System-wide cap on verification emails per rolling day (default 400). Harmful-report alerts and
# other safety emails are never counted against it.
VERIFICATION_DAILY_CAP=400

# Bearer secret that protects /api/cron/sweep (Vercel sends it automatically as a Bearer token).
CRON_SECRET=

# Mail. "gmail" sends real email over Gmail SMTP with an app password (needs 2-Step Verification on
# the Google account). "console" prints only template names and is for local development only; the
# app refuses to start it in production.
MAIL_PROVIDER=gmail
MAIL_FROM=Memento
GMAIL_USER=
GMAIL_APP_PASSWORD=
# The operator's address: receives every harmful-report alert and sweep-failure alert.
OPERATOR_EMAIL=

# Public base URL used in emailed links (reset, verification, dashboard).
APP_BASE_URL=http://localhost:3000

# Only used by the pre-event mail capacity rehearsal (quickstart scenario 32).
EXPECTED_PEAK_GUESTS=
